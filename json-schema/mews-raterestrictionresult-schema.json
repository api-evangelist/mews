    "LengthRestrictions": {
      "type": "array",
      "items": {
        "$ref": "#/components/schemas/LengthRestriction"
      },
      "description": "Length restrictions for the rate."
    }
  },
  "additionalProperties": false,
  "x-schema-id": "RateRestrictionResult"
