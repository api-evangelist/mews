{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/MultipleAccountMergeParameters",
  "title": "MultipleAccountMergeParameters",
  "required": [
    "AccessToken",
    "AccountMergeParameters",
    "Client",
    "ClientToken"
  ],
  "type": "object",
  "properties": {
    "ClientToken": {
      "minLength": 1,
      "type": "string",
      "description": "Token identifying the client application."
    },
    "AccessToken": {
      "minLength": 1,
      "type": "string",
      "description": "Access token of the client application."
    },
    "Client": {
      "minLength": 1,
      "type": "string",
      "description": "Name and version of the client application."
    },
    "AccountMergeParameters": {
      "maxItems": 10,
      "minItems": 1,
      "type": "array",
      "items": {
        "$ref": "#/components/schemas/AccountMergeParameter"
      },
      "description": "Accounts to be merged."
    }
  },
  "additionalProperties": false,
  "x-schema-id": "MultipleAccountMergeParameters"
}