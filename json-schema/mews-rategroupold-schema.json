      "description": "Name of the rate group.",
      "nullable": true
    },
    "ExternalIdentifier": {
      "maxLength": 255,
      "type": "string",
      "description": "External identifier of the rate group.",
      "nullable": true
    }
  },
  "additionalProperties": false,
