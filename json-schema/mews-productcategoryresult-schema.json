{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/ProductCategoryResult",
  "title": "ProductCategoryResult",
  "required": [
    "ProductCategories"
  ],
  "type": "object",
  "properties": {
