{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/DeviceCommandResult",
  "title": "DeviceCommandResult",
  "required": [
    "Commands"
  ],
  "type": "object",
  "properties": {
    "Commands": {
      "type": "array",
      "items": {
        "$ref": "#/components/schemas/DeviceCommand"
