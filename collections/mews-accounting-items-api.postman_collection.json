        {
          "id": "8416494c-583f-4648-9eaf-d346fa192e64",
          "name": "Update accounting items",
          "request": {
            "name": "Update accounting items",
            "description": {
              "content": "Updates specified accounting items. You can use this operation to assign an accounting item to a different account or bill. Note this operation supports [Portfolio Access Tokens](https://mews-systems.gitbook.io/connector-api/concepts/multi-property/).\r\n\r\n> **State Restrictions**: Only accounting items in specific states can be moved:\r\n> - **Order items**: Must be in `Open` state\r\n> - **Payments**: Must be in `Pending` state\r\n> \r\n> Attempting to move items in other states (e.g., `Closed`, `Inactive`, `Charged`, `Failed`, `Canceled`) will result in an `Invalid AccountingItemId` error.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "connector",
                "v1",
                "accountingItems",
                "update"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
